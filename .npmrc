# In Docker containers (no TTY), pnpm 11+ refuses to purge node_modules
# when the lockfile has drifted from the installed tree — it asks for
# confirmation, fails, and the container exits. This happens any time a
# dependency change rebuilds the lockfile while the dev containers still
# carry the old node_modules in their anonymous volumes (see docker-
# compose.yml's `/app/*/node_modules` mounts).
# Setting this to `false` makes the purge silent — the right behaviour
# for non-interactive environments. It only affects the modules-purge
# prompt; nothing else about install resolution.
confirm-modules-purge=false
