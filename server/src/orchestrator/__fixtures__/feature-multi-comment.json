            "content": [
              { "type": "text", "text": "+hitl-to-agent+ The existing PDF export uses /api/reports/orders.pdf. The natural place to add CSV is /api/reports/orders.csv with the same query params. Reuse the OrdersReportQuery DTO." }
            ]
          }
        ]
      }
    },
    {
      "id": "c4",
      "author": "dave",
      "createdAt": "2026-04-03T08:00:00.000Z",
