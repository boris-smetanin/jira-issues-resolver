DATABASE_URL=postgres://jir:jir@localhost:5433/jir
PORT=3001
DATA_DIR=./data

# AES-256-GCM master key for encrypting Jira/GitHub tokens at rest.
# 32 random bytes, base64. Auto-generated on first server boot if absent
# AND `.env` is writable. For prod (no bind mount), pre-set this:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Once data is encrypted with a key, the key cannot be changed without losing it.
# MASTER_KEY=
